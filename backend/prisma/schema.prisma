// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMINISTRATIVO
  PROFESIONAL
  PACIENTE
}

model Usuario {
  id             Int          @id @default(autoincrement())
  email          String       @unique
  contrasenaHash String
  nombre         String
  apellido       String
  rol            Rol
  activo         Boolean      @default(true)
  creadoEn       DateTime     @default(now())
  paciente       Paciente?
  profesional    Profesional?
  reprogramaciones ReprogramacionTurno[]
}

model Especialidad {
  id            Int           @id @default(autoincrement())
  nombre        String        @unique
  descripcion   String?
  creadoEn      DateTime      @default(now())
  profesionales Profesional[]
}

model Profesional {
  id               Int              @id @default(autoincrement())
  matricula        String           @unique
  telefono         String?
  creadoEn         DateTime         @default(now())
  especialidadId   Int
  especialidad     Especialidad     @relation(fields: [especialidadId], references: [id])
  usuarioId        Int              @unique
  usuario          Usuario          @relation(fields: [usuarioId], references: [id])
  disponibilidades Disponibilidad[]
  bloqueos         BloqueoDisponibilidad[]
  turnos           Turno[]
}

model Paciente {
  id              Int      @id @default(autoincrement())
  dni             String   @unique
  fechaNacimiento DateTime
  telefono        String?
  creadoEn        DateTime @default(now())
  usuarioId       Int      @unique
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
  turnos          Turno[]
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum EstadoTurno {
  PENDIENTE
  CONFIRMADO
  CANCELADO
  COMPLETADO
}

model Disponibilidad {
  id            Int         @id @default(autoincrement())
  diaSemana     DiaSemana
  horaInicio    String
  horaFin       String
  creadoEn      DateTime    @default(now())
  profesionalId Int
  profesional   Profesional @relation(fields: [profesionalId], references: [id])
}

model Turno {
  id            Int         @id @default(autoincrement())
  fecha         DateTime    @db.Date
  horaInicio    String
  horaFin       String
  estado        EstadoTurno @default(PENDIENTE)
  version       Int         @default(0)
  reprogramaciones ReprogramacionTurno[]
  creadoEn      DateTime    @default(now())
  pacienteId    Int
  paciente      Paciente    @relation(fields: [pacienteId], references: [id])
  profesionalId Int
  profesional   Profesional @relation(fields: [profesionalId], references: [id])
}

model BloqueoDisponibilidad {
  id            Int         @id @default(autoincrement())
  fecha         DateTime    @db.Date
  motivo        String
  profesionalId Int
  profesional   Profesional @relation(fields: [profesionalId], references: [id])
  creadoEn      DateTime    @default(now())

  @@unique([profesionalId, fecha])
}

model ReprogramacionTurno {
  id              Int         @id @default(autoincrement())
  turnoId         Int
  turno           Turno       @relation(fields: [turnoId], references: [id])
  usuarioId       Int
  usuario         Usuario     @relation(fields: [usuarioId], references: [id])
  fechaAnterior   DateTime    @db.Date
  horaAnterior    String
  horaFinAnterior String
  estadoAnterior  EstadoTurno
  fechaNueva      DateTime    @db.Date
  horaNueva       String
  horaFinNueva    String
  motivo          String
  creadoEn        DateTime    @default(now())

  @@index([turnoId, creadoEn, id])
}
